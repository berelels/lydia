{
  "name": "lydia",
  "version": "1.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "A workstation for Linux that lives at the top of your screen, like a dynamic island",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --linux deb -c.electronDist=node_modules/electron/dist",
    "dist:all": "electron-builder --linux deb rpm --x64 --arm64 && electron-builder --linux AppImage --x64 --arm64",
    "dist:flatpak": "electron-builder --linux flatpak --x64"
  },
  "author": {
    "name": "Gabriel Dias",
    "email": "programacao@grupohermesltda.com"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "homepage": "https://github.com/berelels/lydia",
  "build": {
    "appId": "io.github.berelels.lydia",
    "productName": "Lydia",
    "files": [
      "app/**/*",
      "gnome-extension/**/*",
      "assets/logo-*.png",
      "package.json",
      "!**/__pycache__/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "app/**/*.py",
      "gnome-extension/**/*",
      "app/desktop/kwin-script/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "executableName": "lydia",
      "icon": "assets/logo-512.png",
      "category": "Utility",
      "synopsis": "A workstation at the top of your screen",
      "description": "A workstation at the top of your screen: controls, today, system, clipboard, apps, wallpapers, notifications, a music player and a voice assistant, in a dynamic island.",
      "desktop": {
        "entry": {
          "Name": "Lydia",
          "Comment": "A workstation at the top of your screen",
          "StartupWMClass": "lydia",
          "Keywords": "workstation;assistant;voice;clipboard;music;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libgbm1",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "python3",
        "python3-gi",
        "gir1.2-gtk-3.0",
        "xdotool",
        "libasound2",
        "libdrm2",
        "libxkbcommon0",
        "libxrandr2",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "x11-utils",
        "pulseaudio-utils",
        "libglib2.0-bin",
        "fontconfig"
      ],
      "recommends": [
        "bluez",
        "network-manager",
        "wireplumber",
        "pipewire-bin",
        "python3-venv"
      ],
      "priority": "optional"
    },
    "afterPack": "build/after-pack.js",
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "python3",
        "python3-gobject",
        "pulseaudio-utils",
        "fontconfig",
        "mesa-libgbm",
        "alsa-lib",
        "libdrm",
        "libxkbcommon"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=host-os:ro",
        "--filesystem=xdg-pictures:ro",
        "--filesystem=xdg-data/applications:ro",
        "--filesystem=xdg-data/icons:ro",
        "--filesystem=xdg-data/flatpak:ro",
        "--filesystem=/var/lib/flatpak:ro",
        "--filesystem=/var/lib/snapd/desktop:ro",
        "--filesystem=/snap:ro",
        "--filesystem=xdg-data/lydia:create",
        "--filesystem=xdg-data/gnome-shell/extensions:create",
        "--filesystem=xdg-config/autostart:create",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.freedesktop.Notifications"
      ],
      "license": "LICENSE"
    }
  },
  "desktopName": "lydia.desktop"
}
